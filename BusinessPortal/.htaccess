<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production (skip localhost)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ─── Hide the .php extension ─────────────────────────────────────────
    # 1) If the user types /admin/posts.php in the address bar, send a 301
    #    redirect to the clean URL /admin/posts so the browser's URL changes.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^.]+)\.php[\s?]
    RewriteRule ^ %1 [R=301,L]

    # 2) When the clean URL is requested (no extension, not a real file/dir),
    #    serve the matching .php file internally.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Block direct access to gitignored credential files just in case
<FilesMatch "\.credentials\.php$">
    Require all denied
</FilesMatch>

# Block log files & SQL files
<FilesMatch "\.(log|sql|md)$">
    Require all denied
</FilesMatch>

# Block access to config + includes folders
RedirectMatch 403 ^/BusinessPortal/config/.*\.(php|sql)$
RedirectMatch 403 ^/BusinessPortal/includes/.*$

# Security headers for admin panel
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
